#!/bin/sh
# Installs the missing apt packages listed in .chezmoidata.toml and makes zsh the login shell;
# asks for sudo only when one of those is needed.
# packages: {{ .apt.packages | join " " }}
set -eu

command -v apt-get >/dev/null || { echo "No apt-get; skipping system packages." >&2; exit 0; }

missing=""
for pkg in {{ .apt.packages | join " " }}; do
  dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing="$missing $pkg"
done

if [ -n "$missing" ]; then
  echo "Installing apt packages:$missing"
  sudo apt-get update
  # shellcheck disable=SC2086
  sudo apt-get install -y $missing
fi

zsh_path=$(command -v zsh)
if [ "$(getent passwd "$(id -un)" | cut -d: -f7)" != "$zsh_path" ]; then
  echo "Setting the login shell to $zsh_path"
  sudo chsh -s "$zsh_path" "$(id -un)"
fi
