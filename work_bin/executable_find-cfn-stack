#!/bin/bash
# desc: Find CloudFormation stacks whose name matches a pattern in every AWS profile.
# usage: find-cfn-stack <pattern>

stack_to_find=$1

for profile in $(aws configure list-profiles); do
	echo "Checking profile $profile..."
	aws --profile "$profile" cloudformation list-stacks --query 'StackSummaries[*].[StackName]' --output text 2>/dev/null | grep -i "$stack_to_find" | sed 's/\(.*\)/  \1/'
done
