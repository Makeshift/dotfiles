#!/bin/bash
# desc: Stream the current terminal session to anyone who connects with nc.
if [ -n "$1" ] && [[ ! $1 =~ ^[0-9]+$ ]]; then
    echo -e "
Usage: ${0} [port]

Will stream your current shell session to the given port (default 8000, or the next free port).
People can then see your terminal by using 'nc <yourip> <port>'
Use Ctrl+D (or type exit) to kill the stream.
    "
    exit 1
fi
# shellcheck source=executable_colors
source colors
# Output some useful IPs
echo -e "${Yellow}Local:${R}\n$(ifconfig -a | /bin/grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, ""); print "    "$0 }')"
echo -e "${Yellow}Public:${R}\n    $(curl -s checkip.amazonaws.com)"
port=${1:-8000}

# If 8000 is in use, keep going up until we find one that's free
if [ -n "$1" ] && lsof -Pi :"${port}" -sTCP:LISTEN -t > /dev/null; then
    echo "Port $port is in use. Run the script again without an argument to pick an available port."
    exit 1
fi
until ! lsof -Pi :"${port}" -sTCP:LISTEN -t > /dev/null; do
    port=$((port+1))
done
echo -e "${Yellow}Starting stream on port $port.${R}"
echo -e "${Yellow}Use '${Red}nc <your ip> $port${Yellow}' to connect.${R}"
echo -e "${Yellow}Use '${Red}Ctrl-D${Yellow}' (or type exit) to kill the stream.${R}"
file=$(mktemp) # Just for a filename
rm $file
# Named this so my shell can set up a [*] so I remember it's being recorded
file="${file}.ACTIVE_STREAM"
mkfifo "$file"
nc -q0 -k -l "$port" < "$file" > /dev/null &
NC_PID=$!
script -f "$file"
kill "$NC_PID" > /dev/null
# Hides the nasty looking BG kill ;)
wait "$NC_PID" 2> /dev/null
rm "$file" > /dev/null
echo -e "${Yellow} Stream ended.${R}"