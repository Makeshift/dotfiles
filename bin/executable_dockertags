#!/usr/bin/env bash
# desc: List all tags for a container image on any registry, optionally filtered by a pattern.
# usage: dockertags IMAGE [PATTERN]   e.g. dockertags ubuntu, dockertags php apache
set -euo pipefail

if [ $# -lt 1 ]; then
  sed -n 's/^# usage: //p' "$0" >&2
  exit 1
fi

regctl tag ls "$1" | grep -- "${2:-}"
