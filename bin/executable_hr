#!/bin/bash
# desc: Print a horizontal rule across the terminal, one line per string given (default #).
# source: https://github.com/LuRsT/hr
# license: MIT, Copyright (c) 2013 Gil Gonçalves

COLS="$(tput cols)"
if (( COLS <= 0 )) ; then
    COLS="${COLUMNS:-80}"
fi

hr() {
    local WORD="$1"
    local LINE=''

    if [[ -z "$WORD" ]] ; then
        return;
    fi

    printf -v LINE '%*s' "$COLS"
    LINE="${LINE// /${WORD}}"
    echo "${LINE:0:${COLS}}"
}

hrs() {
    local WORD

    for WORD in "${@:-#}"
    do
        hr "$WORD"
    done
}

[ "$0" == "$BASH_SOURCE" ] && hrs "$@"
