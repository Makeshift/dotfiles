#!/bin/bash
# desc: Restore a file by reinstalling the Debian package that owns it.
# source: https://askubuntu.com/a/67028
# usage: sudo restore-file-from-package <file>

set -x
set -e

FILE_TO_RESTORE=$(readlink -e "$1")
PACKAGE=$(dpkg -S "$FILE_TO_RESTORE" | head -1 | cut -d ':' -f1)
mv -n "$FILE_TO_RESTORE" "$FILE_TO_RESTORE.bak"
apt-get -o Dpkg::Options::="--force-confmiss" install --reinstall "$PACKAGE"