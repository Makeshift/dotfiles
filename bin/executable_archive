#!/bin/bash
# desc: Create a .tar.xz archive of the given files or folders.
# usage: archive <file or folder ...> [name.tar.xz]

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: ${0##*/} <file or folder ...> [name.tar.xz]"
  echo "Without a name, uses the single input's name, or the current directory's for several inputs."
  exit 1
fi

function archive() {
  local name filelist=("${@}")
  # Check the first arg to make sure it's a file or folder
  if [ -f "$1" ] || [ -d "$1" ]; then
    # If there's more than 1 arg and the last arg ends in .xz, use that as the name
    if [ $# -gt 1 ] && [[ "${*: -1}" == *.xz ]]; then
      name="${*: -1}"
      unset "filelist[-1]"
    # If there's only one argument, use the name of the that file/folder as the name prefix
    elif [ $# -eq 1 ]; then
      name="$(basename "$1").tar.xz"
    else
      # If there's more than one argument and no name is provided, use the basename of the pwd as the name of the file
      name="$(basename "$PWD").tar.xz"
    fi
    # Create the archive
    tar -cJf "$name" "${filelist[@]}"
  else
    echo "'$1' is not a valid file or directory!" >&2
    return 1
  fi
}

archive "$@"
