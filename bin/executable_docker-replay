#!/usr/bin/env bash
# desc: Print the docker run command that would recreate a running container.
# source: https://github.com/bcicen/docker-replay
# usage: docker-replay CONTAINER
# shellcheck source=docker-tool.sh
. "${BASH_SOURCE[0]%/*}/docker-tool.sh"
docker_tool -s bcicen/docker-replay -p "$@"
