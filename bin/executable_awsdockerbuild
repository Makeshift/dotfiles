#!/bin/bash
# desc: Run docker build with AWS SSO credentials passed as BuildKit secrets.
# Template for RUN:
# RUN --mount=type=secret,id=AWS_ACCESS_KEY_ID,env=AWS_ACCESS_KEY_ID \
#  --mount=type=secret,id=AWS_SECRET_ACCESS_KEY,env=AWS_SECRET_ACCESS_KEY \
#  --mount=type=secret,id=AWS_SESSION_TOKEN,env=AWS_SESSION_TOKEN
AWS_PROFILE=${AWS_PROFILE:-shared-code-artifacts}
eval "$(yawsso -e -p "$AWS_PROFILE" | yawsso decrypt)"
docker build \
  --secret id=AWS_ACCESS_KEY_ID,env=AWS_ACCESS_KEY_ID \
  --secret id=AWS_SECRET_ACCESS_KEY,env=AWS_SECRET_ACCESS_KEY \
  --secret id=AWS_SESSION_TOKEN,env=AWS_SESSION_TOKEN "$@"
