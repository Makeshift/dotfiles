#!/usr/bin/env bash
# desc: Run a command once at a calendar time via a persistent systemd user timer that catches up after sleep or downtime.
# usage: schedule-once <name> <when> <command> [args...]   e.g. schedule-once dentist '2026-10-21 09:00' telegram-call sendMessage '{"text":"Dentist"}'
#   <when> is any systemd calendar spec (check with: systemd-analyze calendar '<when>').
#   The units remove themselves after a successful run; a failed run leaves them for `systemctl --user status once-<name>`.
set -euo pipefail

(($# >= 3)) || { sed -n 's/^# \{0,1\}//; 2,5p' "$0" >&2; exit 2; }
name=$1 when=$2
shift 2
[[ $name =~ ^[A-Za-z0-9_-]+$ ]] || { echo "schedule-once: name must be [A-Za-z0-9_-]+" >&2; exit 2; }
next=$(systemd-analyze calendar "$when" | sed -n 's/^ *Next elapse: //p')
[[ -n $next && $next != never ]] || { echo "schedule-once: '$when' never elapses again" >&2; exit 2; }
# systemd expands % specifiers in Description=.
desc=${*//\%/%%}

unit="once-$name"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
script_dir="${XDG_DATA_HOME:-$HOME/.local/share}/schedule-once"
script="$script_dir/$unit.sh"
[[ -e $unit_dir/$unit.timer ]] && { echo "schedule-once: $unit already exists" >&2; exit 1; }
mkdir -p "$unit_dir" "$script_dir"

# The user manager's PATH lacks nvm, bun and ~/bin, so the job runs with the caller's.
{
  echo '#!/usr/bin/env bash'
  printf 'export PATH=%q\n' "$PATH"
  printf 'cd %q\n' "$HOME"
  printf 'exec'
  printf ' %q' "$@"
  echo
} > "$script"
chmod 700 "$script"

cat > "$unit_dir/$unit.service" <<EOF
[Unit]
Description=One-shot: $desc

[Service]
Type=oneshot
ExecStart=$script
ExecStartPost=/bin/sh -c 'systemctl --user disable $unit.timer; rm -f "$unit_dir/$unit.timer" "$unit_dir/$unit.service" "$script"; systemctl --user daemon-reload'
EOF

cat > "$unit_dir/$unit.timer" <<EOF
[Unit]
Description=One-shot at $when: $desc

[Timer]
OnCalendar=$when
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
EOF

systemctl --user daemon-reload
systemctl --user enable --now "$unit.timer"
systemctl --user list-timers "$unit.timer" --no-pager
