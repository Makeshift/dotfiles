#!/bin/bash
# desc: Edit a list of shell commands, then run them all with GNU parallel.
if [[ "$1" == "--help" || "$1" == "-h" ]] ; then
    echo -e "
Usage: ${0} [file]

Will open an editor and allow you to paste a list of jobs (one per line). Will then run all of those jobs in parallel.
If given an arg, will treat it as a file.
    "
    exit 0
fi

file="$1"
if [ -z "$1" ]; then
    file=$(mktemp)
    trap 'rm -f "$file"' EXIT
    "${EDITOR:-nano}" "$file"
fi
if [ ! -s "$file" ]; then
    echo "No jobs in $file, cancelled." >&2
    exit 1
fi
time parallel :::: "$file"