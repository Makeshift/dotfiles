[data]
  github_username = "makeshift"
  gitconfig_user_signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAWr2SKH9Wu+AET//maFYW0BbI9uHnzuG+9XRlloeWsV"
  {{- if (output "sh" "-c" "uname -r" | lower | contains "microsoft") }}
  is_wsl = true
  {{- /* cmd.exe rather than wslvar: wslu isn't packaged on every Ubuntu release */}}
  windows_username = "{{ (output "sh" "-c" `basename "$(wslpath "$(cd /mnt/c && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')")"` | trim) }}"
  {{- else }}
  is_wsl = false
  windows_username = "UNSET"
  {{- end }}
  dynamic_app_download_path = "/usr/local/bin"
  {{- /* Heavy optional services. Change later with `chezmoi edit-config` then `chezmoi apply`. */}}
  enable_explainshell = {{ promptBoolOnce . "enable_explainshell" "Run the explainshell docker service (pulls a large image)" false }}
