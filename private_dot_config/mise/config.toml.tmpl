# Tools for the dotfiles. Lazy tools install the first time one of their commands runs;
# the rest install on `chezmoi apply` (run_onchange_after_10-mise-install.sh.tmpl).

# Python and Python CLIs come from uv instead (.chezmoidata.toml).

[settings]
# Honour a project's .nvmrc, .node-version, or package.json packageManager.
idiomatic_version_file_enable_tools = ["node", "pnpm"]

[tools]
# Needed by shell startup, chezmoi scripts or systemd units.
chezmoi = "latest"
carapace = "latest"
fzf = "latest"
"github:shoenig/ssh-key-sync" = "latest"
# Startup aliases ls, cat, du and EDITOR to these, so lazy would only defer the download to the first ls.
eza = "latest"
bat = "latest"
dust = "latest"
glow = "latest"
micro = "latest"
uv = "latest"
# The oh-my-zsh direnv plugin hooks it into every prompt.
direnv = "latest"
# LD_PRELOADed by shellrc.d/08_stderred. Pinned: mise hides releases younger than 24h from "latest".
"github:Makeshift/stderred" = "1.1.1"
# Claude Code starts these language servers by name; bdata backs the Bright Data skills.
node = "24"
"npm:bash-language-server" = "latest"
"npm:typescript-language-server" = "latest"
"npm:typescript" = "latest"
"npm:pyright" = "latest"
"npm:yaml-language-server" = "latest"
"npm:@brightdata/cli" = "latest"

# On demand.
jq = { version = "latest", lazy = true }
ripgrep = { version = "latest", lazy = true }
dive = { version = "latest", lazy = true }
tokei = { version = "latest", lazy = true, lazy_bins = ["tokei"] }
regctl = { version = "latest", lazy = true }
"github:makeshift/granted" = { version = "latest", lazy = true, lazy_bins = ["granted"] }
"github:containrrr/shoutrrr" = { version = "latest", lazy = true, lazy_bins = ["shoutrrr"] }
act = { version = "latest", lazy = true, lazy_bins = ["act"] }
"github:asdine/cueimports" = { version = "latest", lazy = true, lazy_bins = ["cueimports"] }
age = { version = "latest", lazy = true, lazy_bins = ["age", "age-keygen"] }
pnpm = { version = "latest", lazy = true, lazy_bins = ["pnpm", "pnpx"] }
"npm:@browsermcp/mcp" = { version = "latest", lazy = true, lazy_bins = ["mcp-server-browsermcp"] }
"npm:@cloudcli-ai/cloudcli" = { version = "latest", lazy = true, lazy_bins = ["cloudcli"] }
"npm:@siteboon/claude-code-ui" = { version = "latest", lazy = true, lazy_bins = ["claude-code-ui"] }
"npm:@sinclair/hammer" = { version = "latest", lazy = true, lazy_bins = ["hammer"] }
"npm:happy" = { version = "latest", lazy = true, lazy_bins = ["happy", "happy-mcp"] }
"npm:opencode-ai" = { version = "latest", lazy = true, lazy_bins = ["opencode"] }
"npm:quicktype" = { version = "latest", lazy = true, lazy_bins = ["quicktype"] }
"npm:task-master-ai" = { version = "latest", lazy = true, lazy_bins = ["task-master", "task-master-ai", "task-master-mcp"] }
{{- if not .is_wsl }}
# On WSL, ~/bin/op links to the Windows op.exe instead, which can unlock through the desktop app.
1password = { version = "latest", lazy = true, lazy_bins = ["op"] }
{{- end }}
# A jar, not a binary: bin/apktool runs it with java.
"github:iBotPeaches/Apktool" = { version = "latest", rename_exe = "apktool.jar" }