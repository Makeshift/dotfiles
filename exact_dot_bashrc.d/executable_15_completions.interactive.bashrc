if runonce -i weekly -n "$0$LINENO"; then
  COMPLETIONS_DIR="${BASH_COMPLETION_USER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion}/completions"
  mkdir -p "$COMPLETIONS_DIR"
  chezmoi completion bash                  --output="$COMPLETIONS_DIR/chezmoi"
  command -v kubectl &>/dev/null && kubectl completion bash          > "$COMPLETIONS_DIR/kubectl"
  command -v helm    &>/dev/null && helm    completion bash          > "$COMPLETIONS_DIR/helm"
  command -v eksctl  &>/dev/null && eksctl  completion bash          > "$COMPLETIONS_DIR/eksctl"
  command -v gh      &>/dev/null && gh      completion -s bash       > "$COMPLETIONS_DIR/gh"
  command -v op      &>/dev/null && op      completion bash          > "$COMPLETIONS_DIR/op"
  command -v pulumi  &>/dev/null && pulumi  completion bash          > "$COMPLETIONS_DIR/pulumi"
  command -v rustup  &>/dev/null && rustup  completions bash         > "$COMPLETIONS_DIR/rustup"
  command -v rustup  &>/dev/null && rustup  completions bash cargo   > "$COMPLETIONS_DIR/cargo"
  command -v bun     &>/dev/null && bun     completions              > "$COMPLETIONS_DIR/bun"
  command -v docker  &>/dev/null && docker  completion bash          > "$COMPLETIONS_DIR/docker"
  command -v ngrok   &>/dev/null && ngrok   completion               > "$COMPLETIONS_DIR/ngrok"
  command -v aws_completer &>/dev/null && printf 'complete -C "%s" aws\n' "$(command -v aws_completer)" > "$COMPLETIONS_DIR/aws"
  command -v register-python-argcomplete &>/dev/null && register-python-argcomplete pipx > "$COMPLETIONS_DIR/pipx"
  printf '[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"\n' > "$COMPLETIONS_DIR/nvm"
fi
