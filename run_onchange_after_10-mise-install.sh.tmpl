#!/bin/sh
# Installs the non-lazy mise tools and rebuilds shims whenever the mise config changes.
# mise config hash: {{ include "private_dot_config/mise/config.toml" | sha256sum }}
set -eu

mise="$HOME/.local/bin/mise"
[ -x "$mise" ] || mise=$(command -v mise)

cd "$HOME"
"$mise" install --yes
"$mise" reshim
